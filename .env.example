# API-client key provisioned by BastionGate. Required by Docker Compose.
BASTIONGATE_API_KEY=

# URL used from inside the Acme People container.
BASTIONGATE_INTERNAL_URL=http://host.docker.internal:8080

# URL opened by the user's browser for the real BastionGate file audit.
BASTIONGATE_PUBLIC_URL=http://localhost:8080

# The API client must be authorized to use this active policy.
BASTIONGATE_POLICY_CODE=DEFAULT

# Published host port for Acme People.
ACME_PEOPLE_PORT=3000

